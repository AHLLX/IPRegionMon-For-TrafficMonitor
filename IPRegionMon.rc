    LTEXT           "URL/Host:",IDC_STATIC,115,163,35,9
    EDITTEXT        IDC_LAT_URL_EDIT,152,161,188,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Add / Update",IDC_LAT_ADD_BUTTON,346,160,68,14

    PUSHBUTTON      "Delete",IDC_LAT_DEL_BUTTON,14,180,42,14
    PUSHBUTTON      "Up",IDC_LAT_UP_BUTTON,60,180,42,14
    PUSHBUTTON      "Down",IDC_LAT_DOWN_BUTTON,106,180,42,14
    PUSHBUTTON      "Test Selected",IDC_LAT_TEST_BUTTON,324,180,90,14
    LTEXT           "Tip: Double-click an item to edit; URLs can include https:// or domain name.",IDC_STATIC,14,198,398,9
END

IDD_TAB_STATUS_INFO DIALOGEX 0, 0, 426, 215
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
