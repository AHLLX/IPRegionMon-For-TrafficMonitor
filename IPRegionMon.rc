#include "resource.h"
#include <windows.h>
#include "winres.h"

#undef APSTUDIO_READONLY_SYMBOLS

// 简体中文资源
#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_CHS)
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#pragma code_page(65001)

// 主容器对话框 (现代 Fluent 布局)
IDD_OPTIONS_DIALOG DIALOGEX 0, 0, 440, 270
STYLE DS_SETFONT | DS_MODALFRAME | WS_CLIPCHILDREN | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IP 地区与网络监控设置"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x0
BEGIN
    CONTROL         "",IDC_TAB_MAIN,"Static",SS_NOTIFY | WS_CHILD | WS_VISIBLE,7,6,426,18
    DEFPUSHBUTTON   "确定",IDOK,315,248,56,15
    PUSHBUTTON      "取消",IDCANCEL,376,248,56,15
END

// Tab 0: 常规与代理设置
IDD_TAB_PROXY_API DIALOGEX 0, 0, 426, 215
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Microsoft YaHei UI", 400, 0, 0x0
BEGIN
    // 卡片 1: 展示偏好与更新 (DLU 0, 0, 426, 54)
    LTEXT           "任务栏格式:",IDC_DISPLAY_FORMAT_LABEL,14,18,45,9
    COMBOBOX        IDC_DISPLAY_FORMAT_COMBO,64,16,115,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "刷新间隔(秒):",IDC_REFRESH_INTERVAL_LABEL,192,18,50,9
    EDITTEXT        IDC_REFRESH_INTERVAL_EDIT,244,16,34,12,ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "立即刷新",IDC_REFRESH_NOW_BUTTON,288,15,50,14
    LTEXT           "",IDC_STATUS_STATIC,64,36,346,11

    // 卡片 2: 代理连接 (DLU 0, 60, 426, 120)
    CONTROL         "启用代理服务器",IDC_USE_PROXY_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,75,80,10
    LTEXT           "代理地址:",IDC_PROXY_LABEL,14,92,38,9
    EDITTEXT        IDC_PROXY_EDIT,56,90,165,12,ES_AUTOHSCROLL
    PUSHBUTTON      "测试代理连通性",IDC_TEST_PROXY_BUTTON,228,89,70,14
    LTEXT           "",IDC_TEST_PROXY_STATUS,14,106,396,10

    // 卡片 3: 公网 IP 探测接口 API (DLU 0, 126, 426, 212)
    LTEXT           "直连 API:",IDC_API_DOMESTIC_LABEL,14,142,36,9
    EDITTEXT        IDC_API_DOMESTIC_EDIT,56,140,354,12,ES_AUTOHSCROLL
    LTEXT           "代理 API:",IDC_API_FOREIGN_LABEL,14,162,36,9
    EDITTEXT        IDC_API_FOREIGN_EDIT,56,160,354,12,ES_AUTOHSCROLL
    LTEXT           "提示：API 决定地理信息的语言；界面语言与 TrafficMonitor 保持一致。",IDC_STATIC,14,184,396,9
END

// Tab 1: 延迟目标设置
IDD_TAB_LATENCY_LIST DIALOGEX 0, 0, 426, 215
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Microsoft YaHei UI", 400, 0, 0x0
BEGIN
    // 卡片 1: 目标列表 (DLU 0, 0, 426, 142)
    CONTROL         "",IDC_LATENCY_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_TABSTOP,8,16,410,120

    // 卡片 2: 节点操作 (DLU 0, 148, 426, 212)
    LTEXT           "名称:",IDC_STATIC,14,163,22,9
    EDITTEXT        IDC_LAT_NAME_EDIT,38,161,68,12,ES_AUTOHSCROLL
    LTEXT           "地址/URL:",IDC_STATIC,112,163,36,9
    EDITTEXT        IDC_LAT_URL_EDIT,150,161,192,12,ES_AUTOHSCROLL
    PUSHBUTTON      "添加/更新",IDC_LAT_ADD_BUTTON,348,160,66,14

    PUSHBUTTON      "删除",IDC_LAT_DEL_BUTTON,14,180,42,14
    PUSHBUTTON      "上移",IDC_LAT_UP_BUTTON,60,180,42,14
    PUSHBUTTON      "下移",IDC_LAT_DOWN_BUTTON,106,180,42,14
    PUSHBUTTON      "测速选中目标",IDC_LAT_TEST_BUTTON,324,180,90,14
    LTEXT           "提示：双击或点击列表项可快速载入编辑；地址可填域名或带 https:// 的完整 URL。",IDC_STATIC,14,198,398,9
END

// Tab 2: 当前状态与安全报告
IDD_TAB_STATUS_INFO DIALOGEX 0, 0, 426, 215
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Microsoft YaHei UI", 400, 0, 0x0
BEGIN
    // 卡片 1: 直连网络状况 (DLU 0, 0, 426, 56)
    LTEXT           "公网 IP: -",IDC_STAT_DIRECT_IP,14,16,210,9
    LTEXT           "地区: -",IDC_STAT_DIRECT_PLACE,14,29,210,9
    LTEXT           "运营商: -",IDC_STAT_DIRECT_ISP,14,42,210,9
    LTEXT           "网络属性与安全: -",IDC_STAT_DIRECT_THREAT,230,16,182,23
    PUSHBUTTON      "复制直连 IP",IDC_BTN_COPY_DIRECT,230,40,65,13

    // 卡片 2: 代理出口状况 (DLU 0, 62, 426, 118)
    LTEXT           "出口 IP: -",IDC_STAT_PROXY_IP,14,78,210,9
    LTEXT           "地区: -",IDC_STAT_PROXY_PLACE,14,91,210,9
    LTEXT           "运营商: -",IDC_STAT_PROXY_ISP,14,104,210,9
    LTEXT           "网络属性与安全: -",IDC_STAT_PROXY_THREAT,230,78,182,23
    PUSHBUTTON      "复制代理 IP",IDC_BTN_COPY_PROXY,230,102,65,13

    // 卡片 3: 完整探测诊断日志 (DLU 0, 124, 426, 212)
    EDITTEXT        IDC_STATUS_INFO_EDIT,10,138,336,68,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "复制全部文本",IDC_BTN_COPY_ALL,352,154,62,18
END

// Version
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,1,1,0
 PRODUCTVERSION 2,1,1,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "By HiTech_NinJa & Contributors"
            VALUE "FileDescription", "IP Region Monitor Plugin for TrafficMonitor"
            VALUE "FileVersion", "2.1.1.0"
            VALUE "InternalName", "IPRegionMon.dll"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "IPRegionMon.dll"
            VALUE "ProductName", "IPRegionMon"
            VALUE "ProductVersion", "2.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

